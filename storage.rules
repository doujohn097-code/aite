rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == 'Twt0A27bx9YcG4vu3RTsR7ifJzf2'
      );
    }
    
    function isAuthorized(userId) {
      return request.auth != null && (userId == request.auth.uid || isAdmin());
    }
  
    function isValidMedia() {
      return request.resource.contentType.matches('image/.*|video/.*|audio/.*')
             && request.resource.size < 100 * 1024 * 1024;
    }

    match /images/{userId}/{fileName} {
      allow read: if true;
      allow create: if isAuthorized(userId) && isValidMedia();
      allow update, delete: if isAuthorized(userId);
    }

    match /media/{userId}/{fileName} {
      allow read: if true;
      allow create: if isAuthorized(userId) && isValidMedia();
      allow update, delete: if isAuthorized(userId);
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isValidMedia();
    }
  }
}
