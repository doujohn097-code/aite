rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isValidMedia() {
      return request.resource.size > 0
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp|avif)|video/(mp4|webm|quicktime)|audio/(mpeg|wav|ogg|webm|mp4|aac)');
    }

    // The application only writes under the authenticated user's directory.
    match /images/{userId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidMedia();
      allow update, delete: if isOwner(userId);
    }
    match /media/{userId}/{fileName} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidMedia();
      allow update, delete: if isOwner(userId);
    }

    // Deny every path that was not explicitly designed above.
    match /{allPaths=**} { allow read, write: if false; }
  }
}
