rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Administrative authority must only come from Firebase Custom Claims.
    // Never trust a field the user can write in /users/{uid}.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isOwnerOrAdmin(userId) { return isOwner(userId) || isAdmin(); }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function publishQuotaCore() {
      let before = get(userPath()).data;
      let after = getAfter(userPath()).data;
      let last = before.get('lastPublishAt', timestamp.date(2000, 1, 1));
      let windowStart = before.get('publishWindowStart', timestamp.date(2000, 1, 1));
      let count = before.get('publishWindowCount', 0);
      let newWindow = request.time > windowStart + duration.value(1, 'h');
      let nextCount = newWindow ? 1 : count + 1;
      return request.time >= last + duration.value(10, 's')
        && nextCount <= 25
        && after.lastPublishAt == request.time
        && after.lastPublishRef is string
        && after.lastPublishRef.size() > 0
        && after.publishWindowCount == nextCount
        && (newWindow
          ? after.publishWindowStart == request.time
          : after.publishWindowStart == windowStart);
    }
    function publishQuotaOk(publishId) {
      return publishQuotaCore() && getAfter(userPath()).data.lastPublishRef == publishId;
    }
    function validTweetContentEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(resource.data.createdBy)
        && changed.hasOnly(['text', 'font', 'images', 'audio', 'edited', 'editedAt', 'updatedAt'])
        && validText(request.resource.data.text, 1000)
        && validImages(request.resource.data.images)
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    function validStoryContentEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(resource.data.userId)
        && changed.hasOnly(['caption', 'images', 'music', 'texts', 'color', 'duration', 'edited', 'editedAt', 'updatedAt'])
        && validText(request.resource.data.caption, 1000)
        && validImages(request.resource.data.images)
        && request.resource.data.userId == resource.data.userId;
    }
    function validText(value, maxLength) { return value == null || (value is string && value.size() <= maxLength); }
    function validImages(images) { return images == null || (images is list && images.size() <= 4); }
    function onlyCurrentUserChanged(oldList, newList) {
      return oldList.toSet().difference(newList.toSet()).hasOnly([request.auth.uid])
        && newList.toSet().difference(oldList.toSet()).hasOnly([request.auth.uid]);
    }
    function onlyCurrentUserMapChanged(oldMap, newMap) {
      return oldMap.diff(newMap).affectedKeys().hasOnly([request.auth.uid]);
    }
    function validFollowUpdate(userId) {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['following', 'followers', 'updatedAt'])
        && ((userId == request.auth.uid
          && onlyCurrentUserChanged(resource.data.get('following', []), request.resource.data.following))
          || (userId != request.auth.uid
          && onlyCurrentUserChanged(resource.data.get('followers', []), request.resource.data.followers)));
    }
    function validTweetInteraction() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && changed.hasOnly(['userLikes', 'userRetweets', 'userReplies', 'updatedAt'])
        && (!changed.hasAny(['userLikes'])
          || onlyCurrentUserChanged(resource.data.userLikes, request.resource.data.userLikes))
        && (!changed.hasAny(['userRetweets'])
          || onlyCurrentUserChanged(resource.data.userRetweets, request.resource.data.userRetweets))
        && (!changed.hasAny(['userReplies'])
          || (request.resource.data.userReplies >= 0
            && (request.resource.data.userReplies == resource.data.userReplies + 1
              || request.resource.data.userReplies == resource.data.userReplies - 1)));
    }
    function validStoryInteraction() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && changed.hasOnly(['likes', 'views', 'userRetweets', 'updatedAt'])
        && (!changed.hasAny(['likes'])
          || onlyCurrentUserChanged(resource.data.get('likes', []), request.resource.data.likes))
        && (!changed.hasAny(['views'])
          || onlyCurrentUserChanged(resource.data.get('views', []), request.resource.data.views))
        && (!changed.hasAny(['userRetweets'])
          || onlyCurrentUserChanged(resource.data.get('userRetweets', []), request.resource.data.userRetweets));
    }
    function conversationParticipantsMatch() {
      return request.resource.data.participants == resource.data.participants;
    }
    function validConversationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return conversationParticipantsMatch()
        && changed.hasOnly(['lastMessage', 'unread', 'typing', 'updatedAt'])
        && (!changed.hasAny(['lastMessage'])
          || request.resource.data.lastMessage.senderId == request.auth.uid)
        && (!changed.hasAny(['typing'])
          || request.resource.data.typing == null
          || request.resource.data.typing == request.auth.uid);
    }
    function blocks(userId, targetId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.get('blockedUsers', []).hasAny([targetId]);
    }
    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    match /tweets/{tweetId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validText(request.resource.data.text, 1000)
        && validImages(request.resource.data.images)
        && request.resource.data.userLikes is list
        && request.resource.data.userLikes.size() == 0
        && request.resource.data.userRetweets is list
        && request.resource.data.userRetweets.size() == 0
        && request.resource.data.userReplies == 0
        && (isAdmin() || publishQuotaOk(tweetId));
      allow update: if isAdmin() || validTweetContentEdit() || validTweetInteraction();
      allow delete: if isOwnerOrAdmin(resource.data.createdBy);
    }

    match /users/{userId} {
      // الملفات الشخصية لا تُقرأ إلا بعد المصادقة. تفرد اسم المستخدم يضمنه
      // بريد Firebase Auth الداخلي، فلا حاجة لكشف الاستعلام قبل التسجيل.
      allow get, list: if signedIn();
      // The client converter derives `id` from the document path and does not
      // store a duplicate id field in the profile document.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['admin'])
        && request.resource.data.verified == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-zA-Z0-9_]{3,15}$')
        && request.resource.data.following is list
        && request.resource.data.following.size() == 0
        && request.resource.data.followers is list
        && request.resource.data.followers.size() == 0;
      // Admin/verified fields are deliberately absent from this allow-list.
      allow update: if isAdmin()
        || validFollowUpdate(userId)
        || (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'bio', 'name', 'website', 'location', 'photoURL', 'coverPhotoURL',
            'theme', 'accent', 'username', 'pinnedTweet', 'storyColor', 'lastStoryAt',
            'storyViews', 'lastActiveAt', 'fcmTokens', 'blockedUsers', 'totalTweets', 'totalReplies',
            'totalPhotos', 'gender', 'onboarded', 'updatedAt',
            'lastPublishAt', 'lastPublishRef', 'publishWindowStart', 'publishWindowCount'
          ]));
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        // الإنشاء خادمي فقط بعد التحقق من الحدث الفعلي (إعجاب/رد/إشارة).
        allow create: if false;
        allow update, delete: if isOwner(userId) || isAdmin();
      }
      match /bookmarks/{bookmarkId} { allow read, write: if isOwner(userId); }
      match /stats/{statId} { allow read, write: if isOwner(userId); }
      match /{document=**} { allow read, write: if isOwnerOrAdmin(userId); }
    }

    match /conversations/{conversationId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.lastMessage == null
        && request.resource.data.unread is map
        // Do not allow a new conversation when either participant blocked the other.
        && !get(/databases/$(database)/documents/users/$(request.resource.data.participants[0])).data.get('blockedUsers', []).hasAny([request.resource.data.participants[1]])
        && !get(/databases/$(database)/documents/users/$(request.resource.data.participants[1])).data.get('blockedUsers', []).hasAny([request.resource.data.participants[0]]);
      // Keep participants and document shape immutable; only validated live fields change.
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && validConversationUpdate();
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow get, list: if signedIn() && request.auth.uid in resource.data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.participants == get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId', 'type', 'text', 'font', 'media', 'audio', 'replyTo',
            'sharedPost', 'reactions', 'participants', 'createdAt', 'seenBy'
          ])
          && (!request.resource.data.keys().hasAny(['font'])
            || request.resource.data.font == null
            || (request.resource.data.font is string
              && request.resource.data.font.size() > 0
              && request.resource.data.font.size() <= 40))
          && ['text', 'image', 'video', 'audio', 'shared'].hasAny([request.resource.data.type])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.size() == 0
          && request.resource.data.seenBy == [request.auth.uid]
          && validImages(request.resource.data.media)
          && !blocks(request.auth.uid, otherParticipant(request.resource.data.participants))
          && !blocks(otherParticipant(request.resource.data.participants), request.auth.uid)
          && validText(request.resource.data.text, 4000);
        allow update: if signedIn() && request.auth.uid in resource.data.participants
          && request.resource.data.senderId == resource.data.senderId
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'reactions'])
              && ((request.resource.data.seenBy != resource.data.seenBy
                  && onlyCurrentUserChanged(resource.data.seenBy, request.resource.data.seenBy))
                || (request.resource.data.reactions != resource.data.reactions
                  && onlyCurrentUserMapChanged(resource.data.reactions, request.resource.data.reactions))))
            // تعديل نص الرسالة من صاحبها (لا يشمل الرسائل المحذوفة)
            || (request.auth.uid == resource.data.senderId
              && resource.data.get('deletedAt', null) == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text', 'edited', 'editedAt'
              ])
              && request.resource.data.edited == true
              && validText(request.resource.data.text, 4000)
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0)
            || (request.auth.uid == resource.data.senderId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text', 'media', 'audio', 'replyTo', 'sharedPost', 'reactions', 'deletedAt'
              ])
              && request.resource.data.text == 'تم حذف هذه الرسالة'
              && request.resource.data.media == null
              && request.resource.data.audio == null
              && request.resource.data.sharedPost == null)
          );
        allow delete: if false;
      }
    }

    match /config/{configId} {
      allow get: if true;
      allow list: if signedIn();
      allow create, update, delete: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validText(request.resource.data.caption, 1000)
        && validImages(request.resource.data.images)
        && request.resource.data.images is list
        && request.resource.data.images.size() >= 1
        && request.resource.data.likes is list
        && request.resource.data.likes.size() == 0
        && request.resource.data.views is list
        && request.resource.data.views.size() == 0
        && (!request.resource.data.keys().hasAny(['userRetweets'])
          || (request.resource.data.userRetweets is list
            && request.resource.data.userRetweets.size() == 0))
        && (!request.resource.data.keys().hasAny(['kind'])
          || ['story', 'reel'].hasAny([request.resource.data.kind]))
        && (isAdmin()
          || (request.resource.data.get('kind', 'story') == 'reel'
            ? publishQuotaOk(storyId)
            : publishQuotaCore()));
      allow update: if isAdmin() || validStoryContentEdit() || validStoryInteraction();
      allow delete: if isOwnerOrAdmin(resource.data.userId);
    }
  }
}
