rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Administrative authority must only come from Firebase Custom Claims.
    // Never trust a field the user can write in /users/{uid}.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isOwnerOrAdmin(userId) { return isOwner(userId) || isAdmin(); }
    function validText(value, maxLength) { return value == null || (value is string && value.size() <= maxLength); }
    function validImages(images) { return images == null || (images is list && images.size() <= 4); }
    function onlyCurrentUserChanged(oldList, newList) {
      return oldList.toSet().difference(newList.toSet()).hasOnly([request.auth.uid])
        && newList.toSet().difference(oldList.toSet()).hasOnly([request.auth.uid]);
    }
    function onlyCurrentUserMapChanged(oldMap, newMap) {
      return oldMap.diff(newMap).affectedKeys().hasOnly([request.auth.uid]);
    }
    function validFollowUpdate(userId) {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['following', 'followers', 'updatedAt'])
        && ((userId == request.auth.uid
          && onlyCurrentUserChanged(resource.data.get('following', []), request.resource.data.following))
          || (userId != request.auth.uid
          && onlyCurrentUserChanged(resource.data.get('followers', []), request.resource.data.followers)));
    }
    function validTweetInteraction() {
      // Only the interaction fields can change. Using affectedKeys instead of
      // reading optional legacy fields (audio/replyTo/etc.) keeps likes working
      // for older posts that do not contain every newer field.
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userLikes', 'userRetweets', 'userReplies', 'updatedAt'])
        && ((request.resource.data.userLikes != resource.data.userLikes
             && onlyCurrentUserChanged(resource.data.userLikes, request.resource.data.userLikes))
            || (request.resource.data.userRetweets != resource.data.userRetweets
             && onlyCurrentUserChanged(resource.data.userRetweets, request.resource.data.userRetweets))
            || (request.resource.data.userReplies != resource.data.userReplies
             && request.resource.data.userReplies >= 0));
    }
    function validStoryInteraction() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'views', 'userRetweets', 'updatedAt'])
        && ((request.resource.data.likes != resource.data.likes
            && onlyCurrentUserChanged(resource.data.likes, request.resource.data.likes))
          || (request.resource.data.views != resource.data.views
            && onlyCurrentUserChanged(resource.data.views, request.resource.data.views))
          || (request.resource.data.userRetweets != resource.data.userRetweets
            && onlyCurrentUserChanged(resource.data.userRetweets, request.resource.data.userRetweets)));
    }
    function conversationParticipantsMatch() {
      return request.resource.data.participants == resource.data.participants;
    }
    function blocks(userId, targetId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.get('blockedUsers', []).hasAny([targetId]);
    }
    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    match /tweets/{tweetId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validText(request.resource.data.text, 1000)
        && validImages(request.resource.data.images);
      // Authors can edit their own content; everyone else can only change their own reaction.
      allow update: if isOwnerOrAdmin(resource.data.createdBy) || validTweetInteraction();
      allow delete: if isOwnerOrAdmin(resource.data.createdBy);
    }

    match /users/{userId} {
      // The signup form must check one username before the user is signed in.
      // Keep that unauthenticated query strictly limited to one result; bulk
      // discovery still requires login.
      allow get, list: if signedIn() || request.query.limit <= 1;
      // The client converter derives `id` from the document path and does not
      // store a duplicate id field in the profile document.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['admin']);
      // Admin/verified fields are deliberately absent from this allow-list.
      allow update: if isAdmin()
        || validFollowUpdate(userId)
        || (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'bio', 'name', 'website', 'location', 'photoURL', 'coverPhotoURL',
            'theme', 'accent', 'username', 'pinnedTweet', 'storyColor', 'lastStoryAt',
            'storyViews', 'lastActiveAt', 'fcmTokens', 'blockedUsers', 'totalTweets', 'totalReplies',
            'totalPhotos', 'gender', 'onboarded', 'updatedAt'
          ]));
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.fromUserId
          && request.resource.data.toUserId == userId;
        allow update, delete: if isOwner(userId) || isAdmin();
      }
      match /bookmarks/{bookmarkId} { allow read, write: if isOwner(userId); }
      match /stats/{statId} { allow read, write: if isOwner(userId); }
      match /{document=**} { allow read, write: if isOwnerOrAdmin(userId); }
    }

    match /conversations/{conversationId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        // Do not allow a new conversation when either participant blocked the other.
        && !get(/databases/$(database)/documents/users/$(request.resource.data.participants[0])).data.get('blockedUsers', []).hasAny([request.resource.data.participants[1]])
        && !get(/databases/$(database)/documents/users/$(request.resource.data.participants[1])).data.get('blockedUsers', []).hasAny([request.resource.data.participants[0]]);
      // Keep participant list immutable; only a participant may update a conversation.
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && conversationParticipantsMatch();
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow get, list: if signedIn() && request.auth.uid in resource.data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.participants == get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && !blocks(request.auth.uid, otherParticipant(request.resource.data.participants))
          && !blocks(otherParticipant(request.resource.data.participants), request.auth.uid)
          && validText(request.resource.data.text, 4000);
        allow update: if signedIn() && request.auth.uid in resource.data.participants
          && request.resource.data.senderId == resource.data.senderId
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'reactions'])
              && ((request.resource.data.seenBy != resource.data.seenBy
                  && onlyCurrentUserChanged(resource.data.seenBy, request.resource.data.seenBy))
                || (request.resource.data.reactions != resource.data.reactions
                  && onlyCurrentUserMapChanged(resource.data.reactions, request.resource.data.reactions))))
            // تعديل نص الرسالة من صاحبها (لا يشمل الرسائل المحذوفة)
            || (request.auth.uid == resource.data.senderId
              && resource.data.get('deletedAt', null) == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text', 'edited', 'editedAt'
              ])
              && request.resource.data.edited == true
              && validText(request.resource.data.text, 4000)
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0)
            || (request.auth.uid == resource.data.senderId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'text', 'media', 'audio', 'replyTo', 'sharedPost', 'reactions', 'deletedAt'
              ])
              && request.resource.data.text == 'تم حذف هذه الرسالة'
              && request.resource.data.media == null
              && request.resource.data.audio == null
              && request.resource.data.sharedPost == null)
          );
        allow delete: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validText(request.resource.data.caption, 1000)
        && validImages(request.resource.data.images)
        && request.resource.data.likes is list
        && request.resource.data.views is list;
      allow update: if isOwnerOrAdmin(resource.data.userId) || validStoryInteraction();
      allow delete: if isOwnerOrAdmin(resource.data.userId);
    }
  }
}
