rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAuthorized(userId) {
      return isOwner(userId) || isAdmin();
    }

    function isValidText(text) {
      return text is string || text == null;
    }

    function isValidImages(images) {
      return (images is list && images.size() <= 4) || images == null;
    }

    function isValidStory(data) {
      return data.userId is string
          && data.color is string
          && isValidText(data.caption)
          && isValidImages(data.images)
          && (data.duration is number || data.duration == null)
          && (data.music == null || (data.music is map && data.music.src is string && data.music.name is string))
          && data.likes is list
          && data.views is list
          && (data.kind == null || data.kind is string)
          && data.createdAt is timestamp
          && data.expiresAt is timestamp
          && data.updatedAt == null;
    }

    function listDiffOnly(oldList, newList) {
      return oldList.toSet().difference(newList.toSet()).hasOnly([request.auth.uid])
          && newList.toSet().difference(oldList.toSet()).hasOnly([request.auth.uid]);
    }

    function isFollowUpdate(userId) {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['following', 'followers', 'updatedAt'])
        && (
          (userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['following', 'updatedAt'])
            && listDiffOnly(resource.data.get('following', []), request.resource.data.following))
          ||
          (userId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'updatedAt'])
            && listDiffOnly(resource.data.get('followers', []), request.resource.data.followers))
        );
    }

    match /tweets/{tweetId} {
      allow read: if request.auth != null;
      allow create: if isAuthorized(request.resource.data.createdBy)
                       && isValidText(request.resource.data.text)
                       && isValidImages(request.resource.data.images);
      allow update: if request.auth != null;
      allow delete: if isAuthorized(resource.data.createdBy);
    }

    match /users/{userId} {
      allow get, list: if request.auth != null || request.query.limit <= 1;
      allow create: if isAuthorized(userId);
      allow update: if isAuthorized(userId) || isFollowUpdate(userId);
      allow delete: if isAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, list: if isOwner(userId);
      allow create: if request.auth != null
                       && request.auth.uid == request.resource.data.fromUserId
                       && request.resource.data.toUserId == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAuthorized(userId);
    }

    // العضوية تُفحص من بيانات المستند مباشرة (بدون get() حتى تعمل استعلامات القوائم)
    match /conversations/{conversationId} {
      allow get, list: if request.auth != null
                   && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                     && request.auth.uid in request.resource.data.participants
                     && request.resource.data.participants.size() >= 2;
      // التعديل: مشارك فقط، مع منع تعديل قائمة المشاركين
      allow update: if request.auth != null
                     && request.auth.uid in resource.data.participants
                     && request.resource.data.participants == resource.data.participants;
      allow delete: if request.auth != null
                     && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        // الرسائل تحمل نسخة من participants — عضوية بدون get()
        allow get, list: if request.auth != null
                     && request.auth.uid in resource.data.participants;
        allow create: if request.auth != null
                       && request.resource.data.participants.hasAll([request.auth.uid])
                       && request.resource.data.senderId == request.auth.uid;
        // التعديل مقتصر على حقول seenBy/reactions فقط — لا يمكن تعديل محتوى الرسالة
        allow update: if request.auth != null
                       && request.auth.uid in resource.data.participants
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'reactions'])
                       && request.resource.data.senderId == resource.data.senderId;
        allow delete: if request.auth != null
                       && request.auth.uid in resource.data.participants
                       && resource.data.senderId == request.auth.uid;
      }
    }

    match /stories/{storyId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null
                       && isAuthorized(request.resource.data.userId)
                       && isValidStory(request.resource.data);
      allow update: if request.auth != null
                       && (
                         request.auth.uid == resource.data.userId
                         || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'views', 'userRetweets', 'updatedAt'])
                       );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
